  "5_definitions_metriques": {
    "definition_wape": "SUM|yhat - y| / SUM|y|, poolé sur toutes les lignes (jamais moyenné par produit)",
    "definition_biais": "SUM(yhat - y) / SUM(y), normalisé donc invariant au grain",
